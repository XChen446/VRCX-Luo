-- SCHEMA
CREATE TABLE gamelog_join_leave ( id INTEGER PRIMARY KEY, created_at TEXT, type TEXT, display_name TEXT, location TEXT, user_id TEXT, time INTEGER, UNIQUE(created_at, type, display_name) );
CREATE TABLE gamelog_location ( id INTEGER PRIMARY KEY, created_at TEXT, location TEXT, world_id TEXT, world_name TEXT, time INTEGER, group_name TEXT DEFAULT '', UNIQUE(created_at, location) );
CREATE TABLE userA1_avatar_history ( avatar_id TEXT PRIMARY KEY, created_at TEXT , time INTEGER DEFAULT 0);
CREATE TABLE userA1_feed_gps ( id INTEGER PRIMARY KEY, created_at TEXT, user_id TEXT, display_name TEXT, location TEXT, world_name TEXT, previous_location TEXT, time INTEGER , group_name TEXT DEFAULT '');
CREATE TABLE userA1_feed_online_offline ( id INTEGER PRIMARY KEY, created_at TEXT, user_id TEXT, display_name TEXT, type TEXT, location TEXT, world_name TEXT, time INTEGER , group_name TEXT DEFAULT '');
CREATE TABLE userA1_friend_log_current ( user_id TEXT PRIMARY KEY, display_name TEXT, trust_level TEXT , friend_number INTEGER DEFAULT 0);
CREATE TABLE userA1_friend_log_history ( id INTEGER PRIMARY KEY, created_at TEXT, type TEXT, user_id TEXT, display_name TEXT, previous_display_name TEXT, trust_level TEXT, previous_trust_level TEXT , friend_number INTEGER DEFAULT 0);
CREATE TABLE userA1_notifications ( id TEXT PRIMARY KEY, created_at TEXT, type TEXT, sender_user_id TEXT, sender_username TEXT, receiver_user_id TEXT, message TEXT, world_id TEXT, world_name TEXT, image_url TEXT, invite_message TEXT, request_message TEXT, response_message TEXT, expired INTEGER );
CREATE TABLE userB2_avatar_history ( avatar_id TEXT PRIMARY KEY, created_at TEXT , time INTEGER DEFAULT 0);
CREATE TABLE userB2_feed_gps ( id INTEGER PRIMARY KEY, created_at TEXT, user_id TEXT, display_name TEXT, location TEXT, world_name TEXT, previous_location TEXT, time INTEGER , group_name TEXT DEFAULT '');
CREATE TABLE userB2_feed_online_offline ( id INTEGER PRIMARY KEY, created_at TEXT, user_id TEXT, display_name TEXT, type TEXT, location TEXT, world_name TEXT, time INTEGER , group_name TEXT DEFAULT '');
CREATE TABLE userB2_friend_log_current ( user_id TEXT PRIMARY KEY, display_name TEXT, trust_level TEXT , friend_number INTEGER DEFAULT 0);
CREATE TABLE userB2_friend_log_history ( id INTEGER PRIMARY KEY, created_at TEXT, type TEXT, user_id TEXT, display_name TEXT, previous_display_name TEXT, trust_level TEXT, previous_trust_level TEXT , friend_number INTEGER DEFAULT 0);
CREATE TABLE userB2_notifications ( id TEXT PRIMARY KEY, created_at TEXT, type TEXT, sender_user_id TEXT, sender_username TEXT, receiver_user_id TEXT, message TEXT, world_id TEXT, world_name TEXT, image_url TEXT, invite_message TEXT, request_message TEXT, response_message TEXT, expired INTEGER );
CREATE INDEX idx_gamelog_jl_display_created ON gamelog_join_leave (display_name, created_at);
CREATE INDEX idx_gamelog_jl_location ON gamelog_join_leave (location);
CREATE INDEX idx_gamelog_jl_user_created ON gamelog_join_leave (user_id, created_at);
CREATE INDEX idx_gamelog_location_world_created ON gamelog_location (world_id, created_at);
CREATE INDEX userA1_friend_log_history_user_id_idx ON userA1_friend_log_history (user_id);
CREATE INDEX userB2_friend_log_history_user_id_idx ON userB2_friend_log_history (user_id);
